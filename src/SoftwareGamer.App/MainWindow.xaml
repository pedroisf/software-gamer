<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SoftwareGamer.App.MainWindow" Title="Software Gamer" Width="1280" Height="900" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
<Grid Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0"><TextBlock Text="G" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Text="Software Gamer" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="CONTROLE DO SISTEMA" FontSize="10" Foreground="{DynamicResource MutedBrush}" /></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●  Local" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,20,8" /><Button Content="Restaurar ajustes" Click="RestoreAllClick" /></StackPanel></Grid>
<ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
<Grid Margin="0,8,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Seu computador, em foco." FontSize="30" FontWeight="SemiBold" /><TextBlock Text="Limpeza, perfis e recuperação. Tudo em um só lugar." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Analisar temporários" Click="ScanClick" Style="{StaticResource PrimaryButton}" /></StackPanel></Grid><UniformGrid Columns="3">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMÓRIA EM USO" Style="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="MemoryText" Text="—" FontSize="30" Margin="0,10" FontWeight="SemiBold" /><TextBlock Text="Leitura do Windows. Não esvaziamos a RAM." Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ARQUIVOS EXCLUÍDOS" Style="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="FreedText" Text="0 B" FontSize="30" Margin="0,10" FontWeight="SemiBold" /><TextBlock Text="Tamanho lógico. Quarentena não libera espaço." Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AJUSTES ATIVOS / PENDENTES" Style="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="ChangesText" Text="0" FontSize="30" Margin="0,10" FontWeight="SemiBold" /><TextBlock x:Name="SourceText" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
          </UniformGrid>
          <Expander Header="Detalhes do sistema" Margin="0,0,0,22"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="SystemText" Style="{StaticResource Muted}" Margin="0,12,0,0" /><TextBlock x:Name="RuntimeText" Style="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel></Expander>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<Border x:Name="CleanerSection" Style="{StaticResource Card}"><Grid Height="350"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Revise antes de remover" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Somente temporários do seu usuário, em NTFS local, antigos e fora de uso. Links, arquivos pessoais e caches de jogos não são limpos automaticamente." Style="{StaticResource Muted}" Margin="0,8,0,12" /></StackPanel>
          <WrapPanel Grid.Row="1"><Button Content="Analisar" Style="{StaticResource PrimaryButton}" Click="ScanClick" /><Button Content="Cancelar operação" Click="CancelClick" /><Button Content="Selecionar todos" Click="SelectAllClick" /><Button Content="Limpar seleção" Click="SelectNoneClick" /><Button Content="Mover selecionados para quarentena" Click="QuarantineClick" /></WrapPanel>
          <DataGrid x:Name="FilesGrid" Grid.Row="2" AutomationProperties.Name="Arquivos candidatos à limpeza" EnableRowVirtualization="True">
            <DataGrid.Columns><DataGridCheckBoxColumn Header="Usar" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55" /><DataGridTextColumn Header="Arquivo" Binding="{Binding Item.Name}" Width="210" IsReadOnly="True" /><DataGridTextColumn Header="Tamanho" Binding="{Binding Item.SizeLabel}" Width="95" IsReadOnly="True" /><DataGridTextColumn Header="Caminho" Binding="{Binding Item.Path}" Width="*" IsReadOnly="True" /></DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="ScanSummary" Grid.Row="3" Text="Nenhuma análise realizada. Todos os arquivos começam desmarcados." Style="{StaticResource Muted}" Margin="0,14,0,0" />
        </Grid>
      </Border>
<Border x:Name="ProfilesSection" Grid.Column="1" Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12" Height="160"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Seus jogos" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" /><Button Content="Adicionar executável" Click="AddProfileClick" /></StackPanel><ListBox x:Name="ProfilesList" SelectionChanged="ProfileSelected" AutomationProperties.Name="Perfis salvos" /></DockPanel>
          <Expander x:Name="ProfileDetails" Header="Configurar perfil e processo"><StackPanel Margin="0">
            <TextBlock Text="Ajustes do perfil" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Escolha opções reversíveis para o executável selecionado." Style="{StaticResource Muted}" Margin="0,8,0,16" />
            <TextBlock Text="Nome do jogo" /><TextBox x:Name="ProfileName" AutomationProperties.Name="Nome do perfil" />
            <TextBlock Text="Executável" /><TextBox x:Name="ProfilePath" IsReadOnly="True" AutomationProperties.Name="Caminho do jogo" />
            <CheckBox x:Name="PriorityCheck" Content="Usar prioridade AboveNormal durante a sessão" />
            <TextBlock Text="Plano de energia — aplicado somente na tomada" /><ComboBox x:Name="PowerCombo" AutomationProperties.Name="Plano de energia do perfil" />
            <TextBlock Text="Um plano de desempenho pode elevar consumo e temperatura. Não alteramos CPU, PCIe, Registro de rede, pagefile ou Standby List." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
            <WrapPanel><Button Content="Salvar perfil" Style="{StaticResource PrimaryButton}" Click="SaveProfileClick" /><Button Content="Excluir perfil" Click="DeleteProfileClick" /><Button Content="Iniciar jogo" Click="LaunchClick" /></WrapPanel>
            <TextBlock Text="Processo em execução" Margin="0,10,0,0" /><ComboBox x:Name="ProcessCombo" AutomationProperties.Name="Processos em execução" />
            <WrapPanel><Button Content="Atualizar processos" Click="RefreshProcessesClick" /><Button Content="Aplicar ao processo" Click="ApplyClick" /></WrapPanel>
            <CheckBox x:Name="AutoCheck" Content="Aplicar perfis automaticamente enquanto este aplicativo estiver aberto" Click="AutoClick" />
            <TextBlock Text="Fechar o aplicativo restaura os ajustes. A troca de plano registra temporariamente uma recuperação no próximo logon para cobrir reinicializações inesperadas." Style="{StaticResource Muted}" FontSize="12" />
          </StackPanel></Expander></StackPanel></Border></Grid>
<Border x:Name="RecoverySection" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recuperação" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Revise ajustes e arquivos preservados. Você decide o que restaurar." Style="{StaticResource Muted}" Margin="0,6,0,14" /><Expander x:Name="RecoveryDetails" Header="Ver histórico e quarentena"><Grid Height="560"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Volte ao estado anterior" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Conflitos preservam mudanças feitas fora do aplicativo. Arquivos excluídos permanentemente não podem ser recuperados aqui." Style="{StaticResource Muted}" Margin="0,8,0,12" /></StackPanel>
          <WrapPanel Grid.Row="1"><Button Content="Restaurar todos os ajustes" Style="{StaticResource PrimaryButton}" Click="RestoreAllClick" /><Button Content="Restaurar ajuste selecionado" Click="RestoreOneClick" /><Button Content="Manter estado atual do conflito" Click="KeepCurrentClick" /></WrapPanel>
          <DataGrid x:Name="ChangesGrid" Grid.Row="2" IsReadOnly="True" AutomationProperties.Name="Histórico de ajustes"><DataGrid.Columns><DataGridTextColumn Header="Ajuste" Binding="{Binding Kind}" Width="140" /><DataGridTextColumn Header="Antes" Binding="{Binding Before}" Width="150" /><DataGridTextColumn Header="Aplicado" Binding="{Binding Applied}" Width="150" /><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100" /><DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" /></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="Quarentena · até 2 GiB · sem exclusão automática" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" /><WrapPanel><Button Content="Restaurar arquivo selecionado" Click="RestoreFileClick" /><Button Content="Restaurar todos os arquivos" Click="RestoreFilesClick" /><Button Content="Excluir selecionado permanentemente" Click="PurgeClick" /></WrapPanel></StackPanel>
          <DataGrid x:Name="QuarantineGrid" Grid.Row="4" IsReadOnly="True" AutomationProperties.Name="Arquivos em quarentena"><DataGrid.Columns><DataGridTextColumn Header="Arquivo original" Binding="{Binding OriginalPath}" Width="*" /><DataGridTextColumn Header="Tamanho" Binding="{Binding SizeLabel}" Width="95" /><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110" /><DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150" /></DataGrid.Columns></DataGrid>
        </Grid>
      </Expander></StackPanel></Border>
<Border x:Name="ToolsSection" Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="As configurações oficiais, a um clique" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Estas ações abrem o Windows. Você escolhe o que mudar; alterações manuais não entram no histórico de restauração deste aplicativo." Style="{StaticResource Muted}" Margin="0,10,0,20" />
          <WrapPanel><Button Content="Armazenamento e limpeza do Windows" Tag="ms-settings:storagesense" Click="OpenSettingsClick" /><Button Content="Game Mode" Tag="ms-settings:gaming-gamemode" Click="OpenSettingsClick" /><Button Content="Capturas em segundo plano" Tag="ms-settings:gaming-gamedvr" Click="OpenSettingsClick" /><Button Content="Energia e bateria" Tag="ms-settings:powersleep" Click="OpenSettingsClick" /></WrapPanel>
          <TextBlock Text="Limites importantes" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Ajustes são opcionais e reversíveis. Esta versão ainda não possui assinatura digital comercial. Consulte as limitações no guia do usuário." Style="{StaticResource Muted}" Margin="0,10,0,20" />
          <Border Style="{StaticResource Card}" Margin="0,0,14,16"><StackPanel>
            <TextBlock Text="Atualizações" FontSize="18" FontWeight="SemiBold" />
            <CheckBox x:Name="UpdateCheck" Content="Avisar quando houver uma nova versão" Click="UpdatePreferenceClick" />
            <TextBlock Text="Consulta o GitHub ao abrir e a cada 6 horas. Nenhum perfil, caminho de arquivo ou diagnóstico é enviado. O GitHub recebe os dados normais da conexão, como IP e versão do app." Style="{StaticResource Muted}" Margin="0,4,0,12" />
            <Button Content="Verificar atualizações" Click="CheckUpdatesClick" HorizontalAlignment="Left" />
            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
          </StackPanel></Border>
          <WrapPanel><Button Content="Repositório e versões" Click="OpenRepositoryClick" /><Button Content="Exportar diagnóstico local" Click="ExportClick" /></WrapPanel>
          <TextBlock Text="O diagnóstico contém somente versão, sistema e contagens de estado, sem caminhos de jogos/arquivos ou credenciais." Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel></Border></StackPanel></ScrollViewer>
<Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Pronto. Nenhuma alteração automática." Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxHeight="42" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="VersionText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0" /></Grid></Grid></Window>